{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albums",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages go through the Worker (to redirect the old workers.dev address); hashed files are served directly. /music/* is sliced by the Worker for Range requests (iOS audio).
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // The workers.dev address always stays on. With your own domain (see README), `npm run deploy` adds
  // "routes" + "vars.CANONICAL_ORIGIN" here at deploy time, and workers.dev pages redirect to that domain.
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "live-event-albums",
      // Placeholder. Your real id is kept in .deploy-state.json (not in git) and filled in at deploy time.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Daily storage check (80% warning).
    "crons": ["17 6 * * *"]
  }
}

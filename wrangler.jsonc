{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This file is the same for everyone and is never edited by the deploy scripts. Your own values (Worker name,
  // database id, domain) are passed at build time (scripts/lib/deploy-core.mjs -> vite.config.ts), or come from
  // the Cloudflare dashboard when the site is built from GitHub.
  "name": "albums",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages go through the Worker (to redirect the old workers.dev address); hashed files are served directly. /music/* is sliced by the Worker for Range requests (iOS audio).
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // The workers.dev address always stays on. With your own domain, CANONICAL_ORIGIN (set by `npm run deploy`, or
  // as a variable in the Cloudflare dashboard) makes workers.dev pages redirect to it.
  "workers_dev": true,
  // No separate address per version: an old version must never run against a database that was already updated.
  "preview_urls": false,
  // Keep variables set in the Cloudflare dashboard (e.g. CANONICAL_ORIGIN) when a new version is deployed.
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      // No database id or name on purpose: on a new site Cloudflare creates the database automatically,
      // and later deploys keep using the database that is already connected to the Worker.
      // The site updates the database structure by itself (worker/lib/schema.ts).
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // One trigger, every 15 minutes (worker/index.ts):
    //   every run: after "update now", ask again until the new version is installed (usually nothing to do).
    //   once from 01:00 UTC (night in Israel): look for a new version and rebuild itself when allowed.
    //   once from 06:00 UTC: storage check (80% warning) and housekeeping.
    "crons": ["2,17,32,47 * * * *"]
  }
}
